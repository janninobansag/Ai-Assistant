NODE_ENV=development
API_PORT=4000
# Render supplies PORT automatically. Do not set it locally unless required.
PORT=
WEB_ORIGIN=http://localhost:5173  
# Local web development calls the API directly. In Vercel, set VITE_API_URL=/api/v1
# so its same-site rewrite in vercel.json proxies requests to the Render API.
VITE_API_URL=http://localhost:4000/api/v1
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster_host>/ai-study-assistant?retryWrites=true&w=majority
ACCESS_TOKEN_SECRET=replace-with-a-long-random-secret
REFRESH_TOKEN_SECRET=replace-with-another-long-random-secret
AI_PROVIDER=fake
HOSTED_AI_PROVIDER=gemini
HOSTED_AI_MODEL=
GEMINI_API_KEY=
DAILY_POINTS_LIMIT=20
GLOBAL_DAILY_AI_OPERATIONS=500
AI_MONTHLY_SPEND_LIMIT_USD=0 
API_RATE_LIMIT_PER_MINUTE=120
AUTH_RATE_LIMIT_PER_15_MINUTES=20
AI_CIRCUIT_BREAKER_FAILURES=3
AI_CIRCUIT_BREAKER_COOLDOWN_SECONDS=60
