NODE_ENV=development
API_PORT=4000
WEB_ORIGIN=http://localhost:5173 
# Used by the browser build only. Set this to your deployed API URL before a production build.
VITE_API_URL=http://localhost:4000/api/v1
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster_host>/ai-study-assistant?retryWrites=true&w=majority
ACCESS_TOKEN_SECRET=replace-with-a-long-random-secret
REFRESH_TOKEN_SECRET=replace-with-another-long-random-secret
AI_PROVIDER=fake
HOSTED_AI_PROVIDER=gemini
HOSTED_AI_MODEL=
GEMINI_API_KEY=
DAILY_POINTS_LIMIT=20
GLOBAL_DAILY_AI_OPERATIONS=500
AI_MONTHLY_SPEND_LIMIT_USD=0 
